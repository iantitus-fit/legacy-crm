# Database — Azure Database for PostgreSQL Flexible Server
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/legacycrm?sslmode=require

# Auth — generate a strong random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME

# CORS — production domain (comma-separated if multiple)
CORS_ORIGINS=https://your-app.azurewebsites.net

# SMTP — email sending (estimates, invoices, portal links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Legacy Exteriors
SMTP_FROM_EMAIL=your-email@example.com

# Customer Portal — base URL for portal links in emails
PORTAL_BASE_URL=https://your-app.azurewebsites.net

# File uploads directory (default: /app/uploads)
# UPLOAD_DIR=/app/uploads
